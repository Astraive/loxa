{
  "$id": "https://spec.loxa.dev/schemas/cortex-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOXA Cortex Event",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "service",
    "event",
    "kind",
    "provenance"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this event"
    },
    "schema_version": {
      "type": "string",
      "description": "Version of the event schema"
    },
    "event_version": {
      "type": "string",
      "description": "Version of this specific event definition"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 timestamp when event occurred"
    },
    "service": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Service name"
        },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "event": {
      "type": "string",
      "minLength": 1,
      "description": "What happened (e.g., user.login, http.request)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "event",
        "http",
        "job",
        "queue",
        "cli",
        "cron",
        "log",
        "checkpoint",
        "deploy",
        "metric",
        "trace",
        "topology",
        "incident_signal",
        "remediation",
        "loxa_event",
        "otel_log",
        "otel_span",
        "collector_event"
      ],
      "description": "Type of event"
    },
    "level": {
      "type": "string",
      "enum": ["debug", "info", "warning", "error", "critical"],
      "description": "Severity level"
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "failure", "partial", "unknown"],
      "description": "Outcome of the operation"
    },
    "trace_id": {
      "type": "string",
      "description": "Distributed trace ID"
    },
    "span_id": {
      "type": "string",
      "description": "Distributed span ID"
    },
    "parent_span_id": {
      "type": "string",
      "description": "Parent span ID"
    },
    "request_id": {
      "type": "string",
      "description": "Request or transaction ID"
    },
    "incident_id": {
      "type": "string",
      "description": "Incident this event belongs to (set by Cortex)"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "loxa",
        "collector",
        "otlp",
        "jsonl",
        "manual",
        "replay"
      ],
      "description": "Source of this event"
    },
    "method": {
      "type": "string",
      "description": "HTTP method (for kind=http)"
    },
    "path": {
      "type": "string",
      "description": "URL path (for kind=http)"
    },
    "route": {
      "type": "string",
      "description": "Matched route pattern (for kind=http)"
    },
    "status_code": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "description": "HTTP status code"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Duration in milliseconds"
    },
    "raw": {
      "type": "object",
      "additionalProperties": true,
      "description": "Arbitrary additional data from source"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Cortex ingested this event"
    }
  },
  "additionalProperties": false
}
