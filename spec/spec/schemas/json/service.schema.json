{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Astraive/loxa-spec/spec/schemas/json/service.schema.json",
  "title": "LOXA Service Identity",
  "oneOf": [
    {
      "$ref": "./common.schema.json#/$defs/non_empty_string"
    },
    {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "./common.schema.json#/$defs/non_empty_string"
        },
        "version": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  ]
}
