# Python SDK Environment Variables
# Copy to .env and fill in values

# Connection
# LOXA_COLLECTOR_URL=http://localhost:9308           # Collector endpoint URL
# LOXA_COLLECTOR_ENDPOINT=http://localhost:9308      # Alias for LOXA_COLLECTOR_URL

# Authentication
# LOXA_API_KEY=                                     # Ingest API key (e.g. lx_sec_live_k_xxx_yyyy)

# Service Identity
# LOXA_SERVICE_NAME=my-service                      # Service name
# LOXA_SERVICE=my-service                           # Alias for LOXA_SERVICE_NAME
# LOXA_SERVICE_VERSION=1.0.0                        # Service version
# LOXA_ENVIRONMENT=development                      # Deployment environment
# LOXA_REGION=                                      # Deployment region

# Logging
# LOXA_LOG_LEVEL=info                               # Log level (debug, info, notice, warn, error, fatal)

# Behavior
# LOXA_DUPLICATE_POLICY=canonical_wins              # Duplicate field policy
# LOXA_STRICT=false                                 # Enable strict mode validation
# LOXA_ASYNC_ENABLED=false                          # Enable async emit pipeline

# Buffering
# LOXA_MAX_BUFFER_SIZE=8192                         # Async queue size
# LOXA_BATCH_SIZE=100                               # Number of events per batch
# LOXA_MAX_EVENT_BYTES=262144                       # Maximum byte size for entire events (256KB)

# Config File Overrides
# LOXA_PY_DEFAULTS=                                 # Path to defaults YAML file
# LOXA_PY_CONFIG=                                   # Path to user config YAML file
