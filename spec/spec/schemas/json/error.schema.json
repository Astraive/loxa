{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Astraive/loxa-spec/spec/schemas/json/error.schema.json",
  "title": "LOXA Error",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "stack": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "handled": {
      "type": "boolean"
    },
    "fatal": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
