# Go SDK Environment Variables
# Copy to .env and fill in values

# Connection
# LOZA_DSN=loza://localhost:9308/my-app                # No-userinfo DSN; sets endpoint and DSN metadata
# LOZA_DSN=loza://kingest:s%40cret%3Avalue@collector.example.com/my-app?env=prod
#                                                    # Optional Basic auth: key_id:percent-encoded secret
# LOZA_COLLECTOR_URL=http://localhost:9308             # Endpoint override; does not clear DSN metadata/credentials

# Authentication
# LOZA_API_KEY=                                       # Bearer token (e.g. lx_sec_live_k_xxx_yyyy); highest-priority token credential

# Service Identity
# LOZA_SERVICE_NAME=my-service                      # Service name (required in strict mode)
# LOZA_SERVICE_VERSION=1.0.0                        # Service version
# LOZA_ENVIRONMENT=development                      # Deployment environment
# LOZA_TENANT_ID=                                   # Multi-tenant identifier

# Batching
# LOZA_BATCH_SIZE=100                               # Number of events per batch
# LOZA_FLUSH_INTERVAL=5s                            # Time between automatic flushes
# LOZA_MAX_BUFFER_SIZE=10000                        # Maximum events in buffer before dropping

# Retry
# LOZA_MAX_RETRIES=3                                # Maximum retry attempts
# LOZA_MAX_BACKOFF=30s                              # Maximum backoff duration
# LOZA_TIMEOUT=10s                                  # Request timeout
# LOZA_CONNECTION_TIMEOUT=5s                        # Connection timeout

# Compression
# LOZA_ENABLE_COMPRESSION=true                      # Enable gzip compression for HTTP requests
