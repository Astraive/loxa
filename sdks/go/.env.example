# Go SDK Environment Variables
# Copy to .env and fill in values

# Connection
# LOXA_DSN=loxa://localhost:9308                    # loxa:// connection URI (sets CollectorURL, Environment, Service)
# LOXA_COLLECTOR_URL=http://localhost:9308           # Collector endpoint URL (overrides DSN)

# Authentication
# LOXA_API_KEY=                                     # Ingest API key (e.g. lx_sec_live_k_xxx_yyyy)

# Service Identity
# LOXA_SERVICE_NAME=my-service                      # Service name (required in strict mode)
# LOXA_SERVICE_VERSION=1.0.0                        # Service version
# LOXA_ENVIRONMENT=development                      # Deployment environment
# LOXA_TENANT_ID=                                   # Multi-tenant identifier

# Batching
# LOXA_BATCH_SIZE=100                               # Number of events per batch
# LOXA_FLUSH_INTERVAL=5s                            # Time between automatic flushes
# LOXA_MAX_BUFFER_SIZE=10000                        # Maximum events in buffer before dropping

# Retry
# LOXA_MAX_RETRIES=3                                # Maximum retry attempts
# LOXA_MAX_BACKOFF=30s                              # Maximum backoff duration
# LOXA_TIMEOUT=10s                                  # Request timeout
# LOXA_CONNECTION_TIMEOUT=5s                        # Connection timeout

# Compression
# LOXA_ENABLE_COMPRESSION=true                      # Enable gzip compression for HTTP requests
