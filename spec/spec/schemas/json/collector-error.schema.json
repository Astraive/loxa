{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Astraive/loxa-spec/spec/schemas/json/collector-error.schema.json",
  "title": "LOXA Collector Error",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "./common.schema.json#/$defs/non_empty_string"
    },
    "message": {
      "$ref": "./common.schema.json#/$defs/non_empty_string"
    },
    "retryable": {
      "type": "boolean"
    },
    "field": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    }
  },
  "required": ["code", "message"],
  "additionalProperties": false
}
