# Python SDK Environment Variables
# Copy to .env and fill in values

# Connection
# LOZA_COLLECTOR_URL=http://localhost:9308           # Collector endpoint URL
# LOZA_COLLECTOR_ENDPOINT=http://localhost:9308      # Alias for LOZA_COLLECTOR_URL

# Authentication
# LOZA_API_KEY=                                     # Ingest API key (e.g. lx_sec_live_k_xxx_yyyy)

# Service Identity
# LOZA_SERVICE_NAME=my-service                      # Service name
# LOZA_SERVICE=my-service                           # Alias for LOZA_SERVICE_NAME
# LOZA_SERVICE_VERSION=1.0.0                        # Service version
# LOZA_ENVIRONMENT=development                      # Deployment environment
# LOZA_REGION=                                      # Deployment region

# Logging
# LOZA_LOG_LEVEL=info                               # Log level (debug, info, notice, warn, error, fatal)

# Behavior
# LOZA_DUPLICATE_POLICY=canonical_wins              # Duplicate field policy
# LOZA_STRICT=false                                 # Enable strict mode validation
# LOZA_ASYNC_ENABLED=false                          # Enable async emit pipeline

# Buffering
# LOZA_MAX_BUFFER_SIZE=8192                         # Async queue size
# LOZA_BATCH_SIZE=100                               # Number of events per batch
# LOZA_MAX_EVENT_BYTES=262144                       # Maximum byte size for entire events (256KB)

# Config File Overrides
# LOZA_PY_DEFAULTS=                                 # Path to defaults YAML file
# LOZA_PY_CONFIG=                                   # Path to user config YAML file
