{
  "$schema": "loza-dsn-test-cases-v1",
  "description": "Shared test cases for loza:// DSN parsing across all SDKs (Go, JS, Python, Rust).",
  "version": "1.0.0",
  "cases": [
    {
      "name": "localhost dev with explicit port",
      "input": "loza://localhost:9308/demo?tls=false",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "localhost",
        "port": 9308,
        "project": "demo",
        "env": "default",
        "service": "",
        "tls": false,
        "transport": "http",
        "baseURL": "http://localhost:9308",
        "eventsURL": "http://localhost:9308/collectors/demo/events",
        "batchURL": "http://localhost:9308/collectors/demo/events/batch",
        "otlpURL": "http://localhost:9308/collectors/demo/otlp/logs",
        "tailWSURL": "ws://localhost:9308/collectors/demo/tail"
      }
    },
    {
      "name": "localhost default port 9308",
      "input": "loza://localhost/demo?tls=false",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "localhost",
        "port": 9308,
        "project": "demo",
        "env": "default",
        "service": "",
        "tls": false,
        "transport": "http",
        "baseURL": "http://localhost:9308",
        "eventsURL": "http://localhost:9308/collectors/demo/events",
        "batchURL": "http://localhost:9308/collectors/demo/events/batch",
        "otlpURL": "http://localhost:9308/collectors/demo/otlp/logs",
        "tailWSURL": "ws://localhost:9308/collectors/demo/tail"
      }
    },
    {
      "name": "prod default tls=true",
      "input": "loza://collector.example.com/demo",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "collector.example.com",
        "port": 443,
        "project": "demo",
        "env": "default",
        "service": "",
        "tls": true,
        "transport": "http",
        "baseURL": "https://collector.example.com:443",
        "eventsURL": "https://collector.example.com:443/collectors/demo/events",
        "batchURL": "https://collector.example.com:443/collectors/demo/events/batch",
        "otlpURL": "https://collector.example.com:443/collectors/demo/otlp/logs",
        "tailWSURL": "wss://collector.example.com:443/collectors/demo/tail"
      }
    },
    {
      "name": "custom env and service",
      "input": "loza://collector.example.com/demo?env=prod&service=api",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "collector.example.com",
        "port": 443,
        "project": "demo",
        "env": "prod",
        "service": "api",
        "tls": true,
        "transport": "http",
        "baseURL": "https://collector.example.com:443"
      }
    },
    {
      "name": "otlp transport",
      "input": "loza://collector.example.com/demo?transport=otlp",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "collector.example.com",
        "port": 443,
        "project": "demo",
        "env": "default",
        "service": "",
        "tls": true,
        "transport": "otlp",
        "baseURL": "https://collector.example.com:443",
        "otlpURL": "https://collector.example.com:443/collectors/demo/otlp/logs"
      }
    },
    {
      "name": "grpc transport",
      "input": "loza://collector.example.com/demo?transport=grpc",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "collector.example.com",
        "port": 443,
        "project": "demo",
        "env": "default",
        "service": "",
        "tls": true,
        "transport": "grpc",
        "baseURL": "https://collector.example.com:443"
      }
    },
    {
      "name": "127.0.0.1 defaults to tls=false",
      "input": "loza://127.0.0.1/demo",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "127.0.0.1",
        "port": 9308,
        "project": "demo",
        "env": "default",
        "service": "",
        "tls": false,
        "transport": "http",
        "baseURL": "http://127.0.0.1:9308"
      }
    },
    {
      "name": "::1 defaults to tls=false (brackets required)",
      "input": "loza://[::1]/demo",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "::1",
        "port": 9308,
        "project": "demo",
        "env": "default",
        "service": "",
        "tls": false,
        "transport": "http",
        "baseURL": "http://[::1]:9308"
      }
    },
    {
      "name": "tls=auto keeps localhost default",
      "input": "loza://localhost/demo?tls=auto",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "localhost",
        "port": 9308,
        "project": "demo",
        "env": "default",
        "service": "",
        "tls": false,
        "transport": "http",
        "baseURL": "http://localhost:9308"
      }
    },
    {
      "name": "tls=auto keeps remote default",
      "input": "loza://collector.example.com/demo?tls=auto",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "collector.example.com",
        "port": 443,
        "project": "demo",
        "env": "default",
        "service": "",
        "tls": true,
        "transport": "http",
        "baseURL": "https://collector.example.com:443"
      }
    },
    {
      "name": "explicit tls=true on localhost",
      "input": "loza://localhost:8443/demo?tls=true",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "localhost",
        "port": 8443,
        "project": "demo",
        "env": "default",
        "service": "",
        "tls": true,
        "transport": "http",
        "baseURL": "https://localhost:8443"
      }
    },
    {
      "name": "explicit port 4318 with otlp",
      "input": "loza://collector.example.com:4318/backend?env=staging&service=auth&transport=otlp",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "host": "collector.example.com",
        "port": 4318,
        "project": "backend",
        "env": "staging",
        "service": "auth",
        "tls": true,
        "transport": "otlp",
        "baseURL": "https://collector.example.com:4318"
      }
    },
    {
      "name": "credentialed DSN with percent-encoded password",
      "input": "loza://key-id:s%40cret%3Avalue%2Fpart@collector.example.com/demo",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "username": "key-id",
        "password": "s@cret:value/part",
        "host": "collector.example.com",
        "port": 443,
        "project": "demo",
        "collectorName": "demo",
        "env": "default",
        "service": "",
        "tls": true,
        "transport": "http",
        "baseURL": "https://collector.example.com:443"
      }
    },
    {
      "name": "credentialed DSN with percent-encoded username",
      "input": "loza://key%2Did:secret@collector.example.com/demo?env=prod",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "username": "key-id",
        "password": "secret",
        "host": "collector.example.com",
        "port": 443,
        "project": "demo",
        "env": "prod",
        "service": "",
        "tls": true,
        "transport": "http",
        "baseURL": "https://collector.example.com:443",
        "collectorName": "demo"
      }
    },
    {
      "name": "public credential DSN",
      "input": "loza://lz_pub_6DJvd3D0izOaQx3n5BhKqN:@collector.example.com/public-collector?env=prod",
      "valid": true,
      "expected": {
        "scheme": "loza",
        "username": "lz_pub_6DJvd3D0izOaQx3n5BhKqN",
        "password": "",
        "host": "collector.example.com",
        "port": 443,
        "project": "public-collector",
        "collectorName": "public-collector",
        "env": "prod",
        "service": "",
        "tls": true,
        "transport": "http",
        "baseURL": "https://collector.example.com:443",
        "eventsURL": "https://collector.example.com:443/collectors/public-collector/events",
        "batchURL": "https://collector.example.com:443/collectors/public-collector/events/batch",
        "otlpURL": "https://collector.example.com:443/collectors/public-collector/otlp/logs",
        "tailWSURL": "wss://collector.example.com:443/collectors/public-collector/tail"
      }
    },
    {
      "name": "reject empty string",
      "input": "",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject wrong scheme https",
      "input": "https://collector.example.com/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject wrong scheme http",
      "input": "http://collector.example.com/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject no host",
      "input": "loza://",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject triple-slash no host",
      "input": "loza:///project",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject no project",
      "input": "loza://collector.example.com",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject empty project",
      "input": "loza://collector.example.com/",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject empty username",
      "input": "loza://:secret@collector.example.com/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject empty password",
      "input": "loza://key:@collector.example.com/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject userinfo without password",
      "input": "loza://key@collector.example.com/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject username containing encoded colon",
      "input": "loza://key%3Aid:secret@collector.example.com/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject username containing encoded whitespace",
      "input": "loza://key%20id:secret@collector.example.com/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject unencoded reserved password character",
      "input": "loza://key:secret:part@collector.example.com/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject malformed percent escape in credentials",
      "input": "loza://key:secret%ZZ@collector.example.com/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject invalid tls value",
      "input": "loza://collector.example.com/demo?tls=maybe",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject invalid transport value",
      "input": "loza://collector.example.com/demo?transport=random",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject port 0",
      "input": "loza://collector.example.com:0/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject port above 65535",
      "input": "loza://collector.example.com:99999/demo",
      "valid": false,
      "expected": null
    },
    {
      "name": "reject non-numeric port",
      "input": "loza://collector.example.com:abc/demo",
      "valid": false,
      "expected": null
    }
  ]
}
