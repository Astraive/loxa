# CLI Environment Variables
# Copy to .env and fill in values

# Authentication (primary key works for all services)
# LOXA_API_KEY=                                     # Primary ingest API key (works for all services)
# LOXA_COLLECTOR_API_KEY=                           # Collector-specific key (fallback)
# LOXA_CORTEX_API_KEY=                              # Cortex-specific key (fallback)

# Service URLs
# LOXA_CORTEX_URL=http://localhost:9312             # Cortex server URL
# LOXA_COLLECTOR_URL=http://localhost:9308          # Collector endpoint URL

# Config File Overrides
# LOXA_CLI_CONFIG=.loxa-cli.yaml                    # Path to user config file
# LOXA_CLI_DEFAULTS=                                # Path to defaults YAML file

# Output
# NO_COLOR=                                         # Disable colored output (set to any value)
