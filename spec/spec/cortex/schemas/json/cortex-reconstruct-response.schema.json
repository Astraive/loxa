{
  "$id": "https://spec.loxa.dev/schemas/cortex-reconstruct-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOXA Cortex Reconstruct Response",
  "type": "object",
  "required": [
    "incident_id",
    "status",
    "severity",
    "primary_service",
    "affected_services",
    "nodes",
    "edges"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["open", "investigating", "mitigated", "resolved", "unknown"]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "unknown"]
    },
    "primary_service": {
      "type": "string",
      "minLength": 1
    },
    "affected_services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "cortex-graph-node.schema.json"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "cortex-graph-edge.schema.json"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "reason", "confidence"],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Human-readable RCA summary"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence in reconstruction"
    }
  },
  "additionalProperties": false
}
