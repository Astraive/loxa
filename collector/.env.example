# ═══════════════════════════════════════════════════════════════════
# Loxa Collector Environment Variables
# Copy to .env and fill in production values
# ═══════════════════════════════════════════════════════════════════

# ── Auth ──────────────────────────────────────────────────────────
LOXA_STORAGE_ENCRYPTION_KEY=
COLLECTOR_API_KEY=
# COLLECTOR_ALLOW_LOCAL_DEV_KEYS=false   # Set to true to allow lx_local_dev_* keys (dev only!)

# ── mTLS / Origin / Proxy ────────────────────────────────────────
# COLLECTOR_MTLS_ALLOWED_CNS=           # Comma-separated allowed certificate CNs
# COLLECTOR_MTLS_ALLOWED_DNS=           # Comma-separated allowed certificate DNS names
# COLLECTOR_MTLS_ALLOWED_EMAILS=        # Comma-separated allowed certificate emails
# COLLECTOR_ALLOWED_ORIGINS=            # Comma-separated allowed WebSocket origins
# COLLECTOR_TRUSTED_PROXIES=            # Comma-separated trusted proxy CIDRs (e.g. 10.0.0.0/8)

# ── EventBus ─────────────────────────────────────────────────────
LOXA_EVENTBUS_NATS_USERNAME=
LOXA_EVENTBUS_NATS_PASSWORD=
LOXA_EVENTBUS_REDIS_PASSWORD=
# LOXA_EVENTBUS_REDIS_DB=0

# ── Fanout Sinks ─────────────────────────────────────────────────
COLLECTOR_FANOUT_CLICKHOUSE_PASSWORD=
COLLECTOR_FANOUT_S3_ACCESS_KEY=
COLLECTOR_FANOUT_S3_SECRET_KEY=
COLLECTOR_FANOUT_POSTGRES_DSN=

# ── Dedupe ───────────────────────────────────────────────────────
COLLECTOR_DEDUPE_REDIS_PASSWORD=

# ── Cortex Bridge ─────────────────────────────────────────────
# COLLECTOR_CORTEX_BRIDGE_API_KEY=

# ── Observability ────────────────────────────────────────────────
# LOXA_ENABLE_PPROF=1
