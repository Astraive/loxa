{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Astraive/loxa-spec/spec/schemas/json/identity.schema.json",
  "title": "LOXA Identity",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/non_empty_string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "external_id": {
      "type": "string"
    },
    "anonymous_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
