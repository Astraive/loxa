# CLI Environment Variables
# Copy to .env and fill in values

# Authentication (primary key works for all services)
# LOZA_API_KEY=                                     # Primary ingest API key (works for all services)
# LOZA_COLLECTOR_API_KEY=                           # Collector-specific key (fallback)
# LOZA_CORTEX_API_KEY=                              # Cortex-specific key (fallback)

# Service URLs
# LOZA_CORTEX_URL=http://localhost:9312             # Cortex server URL
# LOZA_COLLECTOR_URL=http://localhost:9308          # Collector endpoint URL

# Config File Overrides
# LOZA_CLI_CONFIG=.loza-cli.yaml                    # Path to user config file
# LOZA_CLI_DEFAULTS=                                # Path to defaults YAML file

# Output
# NO_COLOR=                                         # Disable colored output (set to any value)
