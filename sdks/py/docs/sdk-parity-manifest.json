{
  "version": "1.0.0",
  "package": "loxa",
  "scope": "lightweight-sdk",
  "stability": "stable-v1",
  "policy": "full-superset",
  "sdks": ["go", "python", "rust", "javascript"],
  "lifecycle": [
    "StartEvent",
    "StartHTTPEvent",
    "StartJobEvent",
    "StartQueueEvent",
    "StartCLIEvent",
    "StartCronEvent",
    "Append",
    "Enrich",
    "Set",
    "Merge",
    "Delete",
    "Get",
    "GetGroup",
    "Checkpoint",
    "Finish",
    "FinishError",
    "Emit",
    "EmitEvent",
    "Flush",
    "Shutdown"
  ],
  "immediate_logs": ["Debug", "Info", "Warn", "Error", "Fatal"],
  "logger_config": [
    "New",
    "TryNew",
    "Default",
    "Configure",
    "FromContext",
    "HasEvent",
    "Config",
    "Dev",
    "Production",
    "Test",
    "WithService",
    "WithVersion",
    "WithEnvironment",
    "WithSink",
    "WithSampler",
    "WithRedactor",
    "WithSchema",
    "WithEventSchema",
    "WithAsync",
    "WithCollectorEndpoint",
    "WithDuplicatePolicy",
    "WithStatsHandler",
    "WithDeploymentID",
    "WithIncludeHost",
    "WithPanicRecovery"
  ],
  "attrs": [
    "String",
    "Int",
    "Int64",
    "Uint64",
    "Float64",
    "Bool",
    "Time",
    "Duration",
    "Any",
    "Null",
    "Group",
    "UserID",
    "TenantID",
    "WorkspaceID",
    "OrganizationID",
    "SessionID",
    "RequestID",
    "TraceID",
    "SpanID",
    "FeatureFlag",
    "FeatureFlagBool",
    "Experiment",
    "OrderID",
    "CartID",
    "ProductID",
    "CustomerID",
    "Plan",
    "Currency",
    "Amount",
    "Country",
    "Device",
    "Platform",
    "AppVersion",
    "ErrorType",
    "ErrorCode",
    "ErrorMessage",
    "ErrorStack",
    "Retryable",
    "SensitiveString",
    "HashString",
    "MarkSensitive"
  ],
  "schemas": [
    "Schema",
    "SchemaFunc",
    "EventView",
    "DefaultSchema",
    "FlatSchema",
    "NestedSchema",
    "ECSchema",
    "OTelSchema",
    "OTelLogSchema",
    "DatadogSchema",
    "CustomSchema"
  ],
  "sinks": [
    "StdoutSink",
    "StderrSink",
    "FileSink",
    "RotatingFileSink",
    "MemorySink",
    "NoopSink",
    "HTTPBatchSink",
    "CollectorSink"
  ],
  "sampling": [
    "SampleAll",
    "SampleNone",
    "SampleRandom",
    "SampleErrors",
    "SampleSlowRequests",
    "SampleStatusCodes",
    "SampleRoutes",
    "SampleUsers",
    "SampleTenants",
    "SampleFeatureFlag",
    "SampleByHeader",
    "AnySampler",
    "AllSampler",
    "NotSampler"
  ],
  "redaction": [
    "DefaultRedactor",
    "RedactKeys",
    "RedactPatterns",
    "HashKeys",
    "MaskKeys",
    "DropKeys",
    "ComposeRedactors"
  ],
  "stats_handlers": [
    "StatsHandler",
    "DeliveryFailureHandler"
  ],
  "metrics": [
    "MetricsCollector",
    "MetricsSnapshot",
    "RenderPrometheus"
  ],
  "excluded_from_sdk": [
    "ClickHouse",
    "Postgres",
    "DuckDB",
    "Kafka",
    "OTLP",
    "S3",
    "GCS",
    "Loki"
  ],
  "language_specific_optional": {
    "go": ["LoadFromEnv", "LoadFromFile", "PrometheusStatsHandler"],
    "python": ["load_layered_config", "new_client", "PrometheusMetrics"],
    "rust": ["new_logger", "try_new_logger", "render_prometheus"],
    "javascript": ["getDefault", "defaultConfig", "withOptions", "ConfigBuilder"]
  }
}
