{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Astraive/loxa/schema/ingest.schema.json",
  "title": "LOXA Ingest Wrapper",
  "type": "object",
  "required": [
    "api_version",
    "source",
    "events"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": ["v1"]
    },
    "source": {
      "type": "object",
      "required": ["sdk", "version", "service"],
      "properties": {
                "sdk": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["loxa-go", "loxa-py", "loxa-rs", "loxa-cli"]
                    },
                    {
                      "type": "object",
                      "required": ["name", "version"],
                      "properties": {
                        "name": {
                          "type": "string",
                          "enum": ["loxa-go", "loxa-py", "loxa-rs", "loxa-cli"]
                        },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          ],
          "x-loxa-since": "v1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "deployment": {
          "type": "object",
          "properties": {
            "environment": {
              "type": "string"
            },
            "region": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "instance_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "./event.schema.json"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
